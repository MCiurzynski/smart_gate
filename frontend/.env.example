# Base URL the frontend uses for backend calls.
# Default is "/api", which is proxied to the backend by Vite (see vite.config.ts).
# Set an absolute URL only if you want to bypass the dev proxy.
# VITE_API_BASE_URL=http://localhost:8000/api

# Target the Vite dev proxy forwards /api requests to.
# VITE_API_PROXY_TARGET=http://localhost:8000
